{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mcosgriff/glovebox/main/docs/import/schema/interval-schedule.schema.json",
  "title": "Glovebox import: maintenance schedule by interval",
  "description": "Jobs that each repeat at their own interval, for one vehicle. Format version 1. See docs/import/README.md. Intervals are in miles (everyMiles) or kilometres (everyKm); a file uses one of them throughout.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "glovebox",
    "version",
    "kind",
    "items"
  ],
  "properties": {
    "$schema": {
      "description": "Optional. Lets an editor check the file as it is typed. Glovebox ignores it.",
      "$ref": "#/$defs/line",
      "maxLength": 300
    },
    "glovebox": {
      "const": "import"
    },
    "version": {
      "const": 1
    },
    "kind": {
      "const": "interval-schedule"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "line": {
      "description": "Text on one line with no space at either end.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\x00-\\x1f\\x7f-\\x9f]([^\\x00-\\x1f\\x7f-\\x9f]*[^\\s\\x00-\\x1f\\x7f-\\x9f])?$"
    },
    "miles": {
      "description": "Whole miles.",
      "type": "integer",
      "minimum": 1,
      "maximum": 500000
    },
    "km": {
      "description": "Whole kilometres. A file gives every distance in one unit: miles or kilometres, not both.",
      "type": "integer",
      "minimum": 1,
      "maximum": 800000
    },
    "months": {
      "description": "Whole months between one time and the next. Write years as months: 3 years is 36.",
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "anyOf": [
        {
          "required": [
            "everyMiles"
          ]
        },
        {
          "required": [
            "everyKm"
          ]
        },
        {
          "required": [
            "everyMonths"
          ]
        }
      ],
      "properties": {
        "name": {
          "description": "The job. Must be unique in the file, ignoring case.",
          "$ref": "#/$defs/line",
          "maxLength": 60
        },
        "everyMiles": {
          "$ref": "#/$defs/miles"
        },
        "everyKm": {
          "$ref": "#/$defs/km"
        },
        "everyMonths": {
          "$ref": "#/$defs/months"
        },
        "firstAtMiles": {
          "description": "For a job whose first time isn't one interval in: the odometer reading it is first due at, such as 100000 for \"first at 100,000 miles, then every 50,000\". It only matters until the job has been logged once. Left out, the first time is one interval in, like every other.",
          "$ref": "#/$defs/miles"
        },
        "firstAtKm": {
          "description": "The same as firstAtMiles, for a file in kilometres.",
          "$ref": "#/$defs/km"
        },
        "severe": {
          "description": "The interval for hard use (towing, off-road, dust, short trips), if it differs.",
          "type": "object",
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "everyMiles"
              ]
            },
            {
              "required": [
                "everyKm"
              ]
            },
            {
              "required": [
                "everyMonths"
              ]
            }
          ],
          "properties": {
            "everyMiles": {
              "$ref": "#/$defs/miles"
            },
            "everyKm": {
              "$ref": "#/$defs/km"
            },
            "everyMonths": {
              "$ref": "#/$defs/months"
            }
          },
          "not": {
            "required": [
              "everyMiles",
              "everyKm"
            ]
          }
        },
        "severeOnly": {
          "description": "true for a job that exists only under hard use, such as changing the differential oil when towing. Its interval is then the one for hard use, and on normal use it is never due. It can't also have \"severe\". Leave it out for every other job.",
          "const": true
        },
        "rule": {
          "description": "Which interval decides when it is due. Left out, the item follows the rule chosen in Settings.",
          "enum": [
            "whichever-first",
            "whichever-last",
            "mileage-only",
            "time-only"
          ]
        },
        "service": {
          "description": "Which of Glovebox's own service lines resets this item, if one does. Logging that line then counts for this item; left out, the item is logged under \"Your items\".",
          "enum": [
            "oil",
            "engine-air",
            "spark-plugs",
            "plug-wires",
            "ignition-coils",
            "glow-plugs",
            "belt",
            "belt-check",
            "timing-belt",
            "timing-chain",
            "fuel-filter",
            "fuel-system",
            "throttle-body",
            "fuel-injectors",
            "fuel-pump",
            "pcv",
            "egr-valve",
            "evap-system",
            "oxygen-sensor",
            "engine-sensors",
            "turbo",
            "valve-cover-gasket",
            "head-gasket",
            "intake-gasket",
            "oil-pan-gasket",
            "rear-main-seal",
            "engine-mounts",
            "catalytic-converter",
            "muffler",
            "exhaust",
            "rotation",
            "balance",
            "alignment",
            "new-tires",
            "flat",
            "tire-check",
            "tpms",
            "front-pads",
            "rear-pads",
            "brake-pads",
            "rotors",
            "brake-shoes",
            "brake-drums",
            "brake-fluid",
            "brake-fluid-check",
            "brake-inspect",
            "brake-service",
            "calipers",
            "wheel-cylinders",
            "master-cylinder",
            "brake-booster",
            "brake-lines",
            "parking-brake",
            "abs-sensor",
            "trans-fluid",
            "power-steering",
            "washer",
            "fluid-check",
            "coolant",
            "cooling-check",
            "water-pump",
            "thermostat",
            "radiator",
            "radiator-cap",
            "coolant-reservoir",
            "coolant-hoses",
            "cooling-fan",
            "fan-clutch",
            "heater-core",
            "diff-fluid",
            "front-diff-check",
            "front-diff",
            "rear-diff-check",
            "rear-diff",
            "transfer-case-check",
            "transfer-case",
            "driveshaft",
            "cv-axle",
            "axle-seals",
            "u-joints",
            "clutch",
            "clutch-hydraulics",
            "flywheel",
            "trans-pan-gasket",
            "shift-cable",
            "shocks",
            "springs",
            "control-arms",
            "ball-joints",
            "bushings",
            "sway-bar-links",
            "wheel-bearing",
            "tie-rods",
            "steering-rack",
            "power-steering-pump",
            "steering-parts",
            "suspension-check",
            "cabin-air",
            "wipers",
            "battery",
            "battery-check",
            "key-fob-battery",
            "bulbs",
            "headlight-assembly",
            "lights-check",
            "windows-check",
            "window-regulator",
            "door-lock-actuator",
            "air-conditioning",
            "ac-compressor",
            "ac-condenser",
            "blower-motor",
            "starter",
            "alternator",
            "fuses",
            "horn",
            "multi-point",
            "scheduled-service",
            "emissions",
            "safety-inspection",
            "recall",
            "accessory",
            "body",
            "detail"
          ]
        }
      },
      "allOf": [
        {
          "not": {
            "required": [
              "everyMiles",
              "everyKm"
            ]
          }
        },
        {
          "not": {
            "required": [
              "firstAtMiles",
              "firstAtKm"
            ]
          }
        },
        {
          "not": {
            "required": [
              "everyMiles",
              "firstAtKm"
            ]
          }
        },
        {
          "not": {
            "required": [
              "everyKm",
              "firstAtMiles"
            ]
          }
        },
        {
          "not": {
            "required": [
              "severeOnly",
              "severe"
            ]
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mcosgriff/glovebox/main/docs/import/schema/service-history.schema.json",
  "title": "Glovebox import: service history",
  "description": "Maintenance already done on one vehicle, one record per visit. Format version 1; version 2, which adds a record's priced jobs; or version 3, which adds a job's part rows and the invoice's shop supplies, tax and fees. See docs/import/README.md. Odometer readings are in miles (odometer) or kilometres (odometerKm); a file uses one of them throughout.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "glovebox",
    "version",
    "kind",
    "items"
  ],
  "properties": {
    "$schema": {
      "description": "Optional. Lets an editor check the file as it is typed. Glovebox ignores it.",
      "$ref": "#/$defs/line",
      "maxLength": 300
    },
    "glovebox": {
      "const": "import"
    },
    "version": {
      "description": "1; 2 for a file whose records may list priced jobs; 3 for one whose jobs may also list part rows and whose records may give shop supplies, tax and fees. A version-1 or version-2 file is read exactly as it always was.",
      "enum": [
        1,
        2,
        3
      ]
    },
    "kind": {
      "const": "service-history"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000
    }
  },
  "if": {
    "properties": {
      "version": {
        "const": 1
      }
    }
  },
  "then": {
    "properties": {
      "items": {
        "items": {
          "$ref": "#/$defs/record"
        }
      }
    }
  },
  "else": {
    "if": {
      "properties": {
        "version": {
          "const": 2
        }
      }
    },
    "then": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/record2"
          }
        }
      }
    },
    "else": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/record3"
          }
        }
      }
    }
  },
  "$defs": {
    "line": {
      "description": "Text on one line with no space at either end.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\x00-\\x1f\\x7f-\\x9f]([^\\x00-\\x1f\\x7f-\\x9f]*[^\\s\\x00-\\x1f\\x7f-\\x9f])?$"
    },
    "text": {
      "description": "Text that may run over several lines, with no space or blank line at either end.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\x00-\\x1f\\x7f-\\x9f]([^\\x00-\\x09\\x0b-\\x1f\\x7f-\\x9f]*[^\\s\\x00-\\x1f\\x7f-\\x9f])?$"
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "work",
        "doneBy"
      ],
      "oneOf": [
        {
          "required": [
            "odometer"
          ]
        },
        {
          "required": [
            "odometerKm"
          ]
        }
      ],
      "properties": {
        "date": {
          "description": "The day the work was done, as YYYY-MM-DD. Not in the future. Date and odometer together must be unique in the file.",
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "odometer": {
          "description": "Whole miles, as the dash read that day.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9999999
        },
        "odometerKm": {
          "description": "Whole kilometres, as the dash read that day. Give this or odometer, never both. A file gives every distance in one unit: miles or kilometres, not both.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9999999
        },
        "work": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/work"
          }
        },
        "doneBy": {
          "$ref": "#/$defs/doneBy"
        },
        "cost": {
          "description": "Dollars as text, with at most two decimals: \"62.50\". Text, so nothing is rounded.",
          "type": "string",
          "pattern": "^\\d{1,9}(\\.\\d{1,2})?$"
        },
        "notes": {
          "$ref": "#/$defs/text",
          "maxLength": 1000
        }
      }
    },
    "record2": {
      "description": "A record in a version-2 file: as in version 1, except that its lines of work may be in \"work\", in \"jobs\", or both. Together they hold 1 to 30 lines.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "doneBy"
      ],
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "odometer"
              ]
            },
            {
              "required": [
                "odometerKm"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "work"
              ]
            },
            {
              "required": [
                "jobs"
              ]
            }
          ]
        }
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/record/properties/date"
        },
        "odometer": {
          "$ref": "#/$defs/record/properties/odometer"
        },
        "odometerKm": {
          "$ref": "#/$defs/record/properties/odometerKm"
        },
        "work": {
          "description": "Lines of work with no price of their own.",
          "$ref": "#/$defs/record/properties/work"
        },
        "jobs": {
          "description": "Work as the shop priced it: each job has one labor and one parts price for all of its lines, never split between them.",
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/job"
          }
        },
        "doneBy": {
          "$ref": "#/$defs/record/properties/doneBy"
        },
        "cost": {
          "description": "The invoice's grand total, as printed. Never worked out from the jobs' prices: tax and fees are whatever is left over.",
          "$ref": "#/$defs/record/properties/cost"
        },
        "notes": {
          "$ref": "#/$defs/record/properties/notes"
        }
      }
    },
    "record3": {
      "description": "A record in a version-3 file: as in version 2, except that a job's parts may be part rows, and the record may give the invoice's shop supplies, tax, and fees and sublet.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "doneBy"
      ],
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "odometer"
              ]
            },
            {
              "required": [
                "odometerKm"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "work"
              ]
            },
            {
              "required": [
                "jobs"
              ]
            }
          ]
        }
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/record/properties/date"
        },
        "odometer": {
          "$ref": "#/$defs/record/properties/odometer"
        },
        "odometerKm": {
          "$ref": "#/$defs/record/properties/odometerKm"
        },
        "work": {
          "description": "Lines of work with no price of their own.",
          "$ref": "#/$defs/record/properties/work"
        },
        "jobs": {
          "description": "Work as the shop priced it: each job has one labor price for all of its lines, never split between them, and its parts as one price or as the invoice's part rows.",
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/job3"
          }
        },
        "doneBy": {
          "$ref": "#/$defs/record/properties/doneBy"
        },
        "cost": {
          "description": "The invoice's grand total, as printed. Never worked out from the jobs' prices: tax and fees are whatever is left over.",
          "$ref": "#/$defs/record/properties/cost"
        },
        "shopSupplies": {
          "description": "Shop supplies charged on the whole invoice, not on a job: dollars as text, as cost is. Leave it out if the invoice doesn't give it.",
          "$ref": "#/$defs/money"
        },
        "tax": {
          "description": "Tax on the whole invoice, written as shopSupplies is.",
          "$ref": "#/$defs/money"
        },
        "fees": {
          "description": "Fees and sublet on the whole invoice, written as shopSupplies is.",
          "$ref": "#/$defs/money"
        },
        "notes": {
          "$ref": "#/$defs/record/properties/notes"
        }
      }
    },
    "job": {
      "description": "One job as the shop priced it. It needs a price, wording of its own, or more than one line; a line with none of them goes in the record's \"work\".",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work"
      ],
      "anyOf": [
        {
          "required": [
            "labor"
          ]
        },
        {
          "required": [
            "parts"
          ]
        },
        {
          "required": [
            "wording"
          ]
        },
        {
          "properties": {
            "work": {
              "minItems": 2
            }
          }
        }
      ],
      "properties": {
        "wording": {
          "description": "The shop's name for the job, as printed: \"Remove & Replace Spark Plugs and Ignition Coils\". Left out, the job is named by its lines.",
          "$ref": "#/$defs/line",
          "maxLength": 120
        },
        "labor": {
          "description": "Labor for the whole job: dollars as text, with at most two decimals. \"0.00\" is a price; leave it out if the invoice doesn't give one.",
          "$ref": "#/$defs/money"
        },
        "parts": {
          "description": "Parts for the whole job, written as labor is.",
          "$ref": "#/$defs/money"
        },
        "work": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/work"
          }
        }
      }
    },
    "job3": {
      "description": "One job as the shop priced it, in a version-3 file: as in version 2, except that its parts may be partRows instead of parts. It needs a price, wording of its own, part rows, or more than one line.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work"
      ],
      "anyOf": [
        {
          "required": [
            "labor"
          ]
        },
        {
          "required": [
            "parts"
          ]
        },
        {
          "required": [
            "partRows"
          ]
        },
        {
          "required": [
            "wording"
          ]
        },
        {
          "properties": {
            "work": {
              "minItems": 2
            }
          }
        }
      ],
      "properties": {
        "wording": {
          "description": "The shop's name for the job, as printed: \"Remove & Replace Spark Plugs and Ignition Coils\". Left out, the job is named by its lines.",
          "$ref": "#/$defs/line",
          "maxLength": 120
        },
        "labor": {
          "description": "Labor for the whole job: dollars as text, with at most two decimals. \"0.00\" is a price; leave it out if the invoice doesn't give one.",
          "$ref": "#/$defs/money"
        },
        "parts": {
          "description": "Parts for the whole job, written as labor is.",
          "$ref": "#/$defs/money"
        },
        "partRows": {
          "description": "The job's parts as the invoice itemizes them, instead of parts. The job's parts price is the sum of the rows' totals.",
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/partRow"
          }
        },
        "work": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/work"
          }
        }
      },
      "not": {
        "required": [
          "parts",
          "partRows"
        ]
      }
    },
    "partRow": {
      "description": "One row of a job's parts, as printed. Nothing is worked out from the others: give what the invoice gives. A row needs at least one of part, quantity, each or total.",
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "part"
          ]
        },
        {
          "required": [
            "quantity"
          ]
        },
        {
          "required": [
            "each"
          ]
        },
        {
          "required": [
            "total"
          ]
        }
      ],
      "properties": {
        "part": {
          "description": "The part as printed: \"NGK 93501 spark plug\".",
          "$ref": "#/$defs/line",
          "maxLength": 120
        },
        "quantity": {
          "description": "How many, as text so a decimal arrives exactly: \"4\" or \"5.7\", at most three decimals.",
          "type": "string",
          "pattern": "^\\d{1,7}(\\.\\d{1,3})?$"
        },
        "each": {
          "description": "The price of one: dollars as text, as cost is.",
          "$ref": "#/$defs/money"
        },
        "total": {
          "description": "The row's total, as printed. This is what counts towards the job's parts.",
          "$ref": "#/$defs/money"
        },
        "for": {
          "description": "The label of the one of this job's lines the row is for. Left out, the row is for the whole job.",
          "$ref": "#/$defs/line",
          "maxLength": 80
        }
      }
    },
    "money": {
      "description": "Dollars as text, with at most two decimals: \"62.50\". Text, so nothing is rounded.",
      "type": "string",
      "pattern": "^\\d{1,9}(\\.\\d{1,2})?$"
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "description": "What was done, in your words.",
          "$ref": "#/$defs/line",
          "maxLength": 80
        },
        "service": {
          "description": "Which of Glovebox's own service lines this is, if it is one. This is what lets the line reset a reminder.",
          "enum": [
            "oil",
            "engine-air",
            "spark-plugs",
            "plug-wires",
            "ignition-coils",
            "glow-plugs",
            "belt",
            "belt-check",
            "timing-belt",
            "timing-chain",
            "pcv",
            "engine-sensors",
            "turbo",
            "valve-cover-gasket",
            "head-gasket",
            "intake-gasket",
            "oil-pan-gasket",
            "rear-main-seal",
            "engine-mounts",
            "rotation",
            "balance",
            "alignment",
            "new-tires",
            "flat",
            "tire-check",
            "tpms",
            "front-pads",
            "rear-pads",
            "brake-pads",
            "rotors",
            "brake-shoes",
            "brake-drums",
            "brake-fluid",
            "brake-fluid-check",
            "brake-inspect",
            "brake-service",
            "calipers",
            "wheel-cylinders",
            "master-cylinder",
            "brake-booster",
            "brake-lines",
            "parking-brake",
            "abs-sensor",
            "trans-fluid",
            "power-steering",
            "washer",
            "fluid-check",
            "coolant",
            "cooling-check",
            "water-pump",
            "thermostat",
            "radiator",
            "radiator-cap",
            "coolant-reservoir",
            "coolant-hoses",
            "cooling-fan",
            "fan-clutch",
            "heater-core",
            "inverter-coolant",
            "intercooler-coolant",
            "hybrid-battery-filter",
            "fuel-filter",
            "fuel-system",
            "throttle-body",
            "fuel-injectors",
            "fuel-pump",
            "evap-system",
            "oxygen-sensor",
            "egr-valve",
            "secondary-air-pump",
            "catalytic-converter",
            "muffler",
            "exhaust",
            "diff-fluid",
            "front-diff-check",
            "front-diff",
            "rear-diff-check",
            "rear-diff",
            "transfer-case-check",
            "transfer-case",
            "driveshaft",
            "cv-axle",
            "axle-seals",
            "u-joints",
            "clutch",
            "clutch-hydraulics",
            "flywheel",
            "trans-pan-gasket",
            "shift-cable",
            "shocks",
            "springs",
            "control-arms",
            "ball-joints",
            "bushings",
            "sway-bar-links",
            "wheel-bearing",
            "tie-rods",
            "steering-rack",
            "power-steering-pump",
            "steering-parts",
            "chassis-lube",
            "suspension-check",
            "cabin-air",
            "wipers",
            "wipers-check",
            "battery",
            "battery-check",
            "key-fob-battery",
            "bulbs",
            "headlight-assembly",
            "lights-check",
            "windows-check",
            "window-regulator",
            "sunroof",
            "door-lock-actuator",
            "air-conditioning",
            "ac-flush",
            "ac-compressor",
            "ac-condenser",
            "hvac-check",
            "blower-motor",
            "starter",
            "alternator",
            "fuses",
            "horn",
            "ecu-update",
            "multi-point",
            "pdi",
            "diagnostic",
            "scheduled-service",
            "emissions",
            "safety-inspection",
            "recall",
            "accessory",
            "windshield",
            "mirror",
            "door-handle",
            "body-lube",
            "body",
            "detail"
          ]
        }
      }
    },
    "doneBy": {
      "description": "Who did the work. Only a shop has a name.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "diy",
            "shop"
          ]
        },
        "name": {
          "$ref": "#/$defs/line",
          "maxLength": 60
        }
      },
      "if": {
        "properties": {
          "type": {
            "const": "diy"
          }
        }
      },
      "then": {
        "properties": {
          "name": false
        }
      }
    }
  }
}

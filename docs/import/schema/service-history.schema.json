{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mcosgriff/glovebox/main/docs/import/schema/service-history.schema.json",
  "title": "Glovebox import: service history",
  "description": "Maintenance already done on one vehicle, one record per visit. Format version 1. See docs/import/README.md. Odometer readings are in miles (odometer) or kilometres (odometerKm); a file uses one of them throughout.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "glovebox",
    "version",
    "kind",
    "items"
  ],
  "properties": {
    "$schema": {
      "description": "Optional. Lets an editor check the file as it is typed. Glovebox ignores it.",
      "$ref": "#/$defs/line",
      "maxLength": 300
    },
    "glovebox": {
      "const": "import"
    },
    "version": {
      "const": 1
    },
    "kind": {
      "const": "service-history"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "line": {
      "description": "Text on one line with no space at either end.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\x00-\\x1f\\x7f-\\x9f]([^\\x00-\\x1f\\x7f-\\x9f]*[^\\s\\x00-\\x1f\\x7f-\\x9f])?$"
    },
    "text": {
      "description": "Text that may run over several lines, with no space or blank line at either end.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\x00-\\x1f\\x7f-\\x9f]([^\\x00-\\x09\\x0b-\\x1f\\x7f-\\x9f]*[^\\s\\x00-\\x1f\\x7f-\\x9f])?$"
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "work",
        "doneBy"
      ],
      "oneOf": [
        {
          "required": [
            "odometer"
          ]
        },
        {
          "required": [
            "odometerKm"
          ]
        }
      ],
      "properties": {
        "date": {
          "description": "The day the work was done, as YYYY-MM-DD. Not in the future. Date and odometer together must be unique in the file.",
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "odometer": {
          "description": "Whole miles, as the dash read that day.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9999999
        },
        "odometerKm": {
          "description": "Whole kilometres, as the dash read that day. Give this or odometer, never both. A file gives every distance in one unit: miles or kilometres, not both.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9999999
        },
        "work": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/work"
          }
        },
        "doneBy": {
          "$ref": "#/$defs/doneBy"
        },
        "cost": {
          "description": "Dollars as text, with at most two decimals: \"62.50\". Text, so nothing is rounded.",
          "type": "string",
          "pattern": "^\\d{1,9}(\\.\\d{1,2})?$"
        },
        "notes": {
          "$ref": "#/$defs/text",
          "maxLength": 1000
        }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "description": "What was done, in your words.",
          "$ref": "#/$defs/line",
          "maxLength": 80
        },
        "service": {
          "description": "Which of Glovebox's own service lines this is, if it is one. This is what lets the line reset a reminder.",
          "enum": [
            "oil",
            "engine-air",
            "spark-plugs",
            "plug-wires",
            "ignition-coils",
            "glow-plugs",
            "belt",
            "belt-check",
            "timing-belt",
            "timing-chain",
            "fuel-filter",
            "fuel-system",
            "throttle-body",
            "fuel-injectors",
            "fuel-pump",
            "pcv",
            "egr-valve",
            "evap-system",
            "oxygen-sensor",
            "engine-sensors",
            "turbo",
            "valve-cover-gasket",
            "head-gasket",
            "intake-gasket",
            "oil-pan-gasket",
            "rear-main-seal",
            "engine-mounts",
            "catalytic-converter",
            "muffler",
            "exhaust",
            "rotation",
            "balance",
            "alignment",
            "new-tires",
            "flat",
            "tire-check",
            "tpms",
            "front-pads",
            "rear-pads",
            "brake-pads",
            "rotors",
            "brake-shoes",
            "brake-drums",
            "brake-fluid",
            "brake-fluid-check",
            "brake-inspect",
            "brake-service",
            "calipers",
            "wheel-cylinders",
            "master-cylinder",
            "brake-booster",
            "brake-lines",
            "parking-brake",
            "abs-sensor",
            "trans-fluid",
            "power-steering",
            "washer",
            "fluid-check",
            "coolant",
            "cooling-check",
            "water-pump",
            "thermostat",
            "radiator",
            "radiator-cap",
            "coolant-reservoir",
            "coolant-hoses",
            "cooling-fan",
            "fan-clutch",
            "heater-core",
            "diff-fluid",
            "front-diff-check",
            "front-diff",
            "rear-diff-check",
            "rear-diff",
            "transfer-case-check",
            "transfer-case",
            "driveshaft",
            "cv-axle",
            "axle-seals",
            "u-joints",
            "clutch",
            "clutch-hydraulics",
            "flywheel",
            "trans-pan-gasket",
            "shift-cable",
            "shocks",
            "springs",
            "control-arms",
            "ball-joints",
            "bushings",
            "sway-bar-links",
            "wheel-bearing",
            "tie-rods",
            "steering-rack",
            "power-steering-pump",
            "steering-parts",
            "suspension-check",
            "cabin-air",
            "wipers",
            "battery",
            "battery-check",
            "key-fob-battery",
            "bulbs",
            "headlight-assembly",
            "lights-check",
            "windows-check",
            "window-regulator",
            "door-lock-actuator",
            "air-conditioning",
            "ac-compressor",
            "ac-condenser",
            "blower-motor",
            "starter",
            "alternator",
            "fuses",
            "horn",
            "multi-point",
            "scheduled-service",
            "emissions",
            "safety-inspection",
            "recall",
            "accessory",
            "body",
            "detail"
          ]
        }
      }
    },
    "doneBy": {
      "description": "Who did the work. Only a shop has a name.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "diy",
            "shop"
          ]
        },
        "name": {
          "$ref": "#/$defs/line",
          "maxLength": 60
        }
      },
      "if": {
        "properties": {
          "type": {
            "const": "diy"
          }
        }
      },
      "then": {
        "properties": {
          "name": false
        }
      }
    }
  }
}

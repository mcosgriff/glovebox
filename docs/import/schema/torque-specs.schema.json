{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mcosgriff/glovebox/main/docs/import/schema/torque-specs.schema.json",
  "title": "Glovebox import: torque specs",
  "description": "Fasteners with socket sizes and torque values for one vehicle. Format version 1. See docs/import/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["glovebox", "version", "kind", "items"],
  "properties": {
    "$schema": {
      "description": "Optional. Lets an editor check the file as it is typed. Glovebox ignores it.",
      "$ref": "#/$defs/line",
      "maxLength": 300
    },
    "glovebox": { "const": "import" },
    "version": { "const": 1 },
    "kind": { "const": "torque-specs" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/spec" }
    }
  },
  "$defs": {
    "line": {
      "description": "Text on one line with no space at either end.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\x00-\\x1f\\x7f-\\x9f]([^\\x00-\\x1f\\x7f-\\x9f]*[^\\s\\x00-\\x1f\\x7f-\\x9f])?$"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "category"],
      "properties": {
        "name": {
          "description": "What the fastener is. Name and category together must be unique in the file, ignoring case.",
          "$ref": "#/$defs/line",
          "maxLength": 60
        },
        "category": { "enum": ["engine", "wheels", "driveline", "suspension", "other"] },
        "socket": {
          "description": "Socket or tool size, as you would say it: \"21 mm\", \"T40\".",
          "$ref": "#/$defs/line",
          "maxLength": 30
        },
        "torque": { "$ref": "#/$defs/torque" },
        "source": {
          "description": "\"factory-manual\" means you copied the value from the factory service manual. Default \"own\".",
          "enum": ["factory-manual", "own"]
        },
        "note": { "$ref": "#/$defs/line", "maxLength": 140 }
      },
      "if": { "required": ["source"], "properties": { "source": { "const": "factory-manual" } } },
      "then": { "required": ["torque"] }
    },
    "torque": {
      "description": "A value and its unit. The most Glovebox accepts is 1,000 N·m, stated here per unit.",
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "enum": ["Nm", "ft-lb", "in-lb"] }
      },
      "oneOf": [
        { "properties": { "unit": { "const": "Nm" }, "value": { "maximum": 1000 } } },
        { "properties": { "unit": { "const": "ft-lb" }, "value": { "maximum": 737 } } },
        { "properties": { "unit": { "const": "in-lb" }, "value": { "maximum": 8850 } } }
      ]
    }
  }
}

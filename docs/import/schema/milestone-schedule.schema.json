{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mcosgriff/glovebox/main/docs/import/schema/milestone-schedule.schema.json",
  "title": "Glovebox import: maintenance schedule by milestone",
  "description": "Mileage points with the work due at each, as an owner's manual prints a schedule. Format version 1. See docs/import/README.md. Mileages are in miles (atMiles, repeatsEveryMiles) or kilometres (atKm, repeatsEveryKm); a file uses one of them throughout.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "glovebox",
    "version",
    "kind",
    "items"
  ],
  "not": {
    "required": [
      "repeatsEveryMiles",
      "repeatsEveryKm"
    ]
  },
  "properties": {
    "$schema": {
      "description": "Optional. Lets an editor check the file as it is typed. Glovebox ignores it.",
      "$ref": "#/$defs/line",
      "maxLength": 300
    },
    "glovebox": {
      "const": "import"
    },
    "version": {
      "const": 1
    },
    "kind": {
      "const": "milestone-schedule"
    },
    "repeatsEveryMiles": {
      "description": "Optional. The length of the whole cycle in whole miles, for a table that starts again after its last milestone: a milestone at 10000 with 120000 here comes round again at 130000, 250000 and so on. Must be at least the highest atMiles in the file. Leave it out for a table that ends.",
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "repeatsEveryKm": {
      "description": "The same, for a table whose milestones are in kilometres (atKm). Must be at least the highest atKm in the file.",
      "type": "integer",
      "minimum": 1,
      "maximum": 1600000
    },
    "items": {
      "description": "In any order; Glovebox shows them by mileage. No two may have the same atMiles.",
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/milestone"
      }
    }
  },
  "$defs": {
    "line": {
      "description": "Text on one line with no space at either end.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\x00-\\x1f\\x7f-\\x9f]([^\\x00-\\x1f\\x7f-\\x9f]*[^\\s\\x00-\\x1f\\x7f-\\x9f])?$"
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work"
      ],
      "oneOf": [
        {
          "required": [
            "atMiles"
          ]
        },
        {
          "required": [
            "atKm"
          ]
        }
      ],
      "properties": {
        "atMiles": {
          "description": "Whole miles the vehicle has covered when this work is due.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "atKm": {
          "description": "Whole kilometres the vehicle has covered when this work is due. Give this or atMiles, never both. A file gives every distance in one unit: miles or kilometres, not both.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1600000
        },
        "orMonths": {
          "description": "The vehicle's age in whole months at which the same work is due if the mileage isn't reached. Shown for information.",
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "work": {
          "description": "A name, and a service, may each appear only once in a milestone.",
          "type": "array",
          "minItems": 1,
          "maxItems": 60,
          "items": {
            "$ref": "#/$defs/job"
          }
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "description": "The work, as your manual words it.",
          "$ref": "#/$defs/line",
          "maxLength": 80
        },
        "service": {
          "description": "Which of Glovebox's own service lines this is, if it is one. Logged work with that service then shows as completing it.",
          "enum": [
            "oil",
            "engine-air",
            "spark-plugs",
            "plug-wires",
            "ignition-coils",
            "glow-plugs",
            "belt",
            "belt-check",
            "timing-belt",
            "timing-chain",
            "pcv",
            "engine-sensors",
            "turbo",
            "valve-cover-gasket",
            "head-gasket",
            "intake-gasket",
            "oil-pan-gasket",
            "rear-main-seal",
            "engine-mounts",
            "rotation",
            "balance",
            "alignment",
            "new-tires",
            "flat",
            "tire-check",
            "tpms",
            "front-pads",
            "rear-pads",
            "brake-pads",
            "rotors",
            "brake-shoes",
            "brake-drums",
            "brake-fluid",
            "brake-fluid-check",
            "brake-inspect",
            "brake-service",
            "calipers",
            "wheel-cylinders",
            "master-cylinder",
            "brake-booster",
            "brake-lines",
            "parking-brake",
            "abs-sensor",
            "trans-fluid",
            "power-steering",
            "washer",
            "fluid-check",
            "coolant",
            "cooling-check",
            "water-pump",
            "thermostat",
            "radiator",
            "radiator-cap",
            "coolant-reservoir",
            "coolant-hoses",
            "cooling-fan",
            "fan-clutch",
            "heater-core",
            "inverter-coolant",
            "intercooler-coolant",
            "hybrid-battery-filter",
            "fuel-filter",
            "fuel-system",
            "throttle-body",
            "fuel-injectors",
            "fuel-pump",
            "evap-system",
            "oxygen-sensor",
            "egr-valve",
            "secondary-air-pump",
            "catalytic-converter",
            "muffler",
            "exhaust",
            "diff-fluid",
            "front-diff-check",
            "front-diff",
            "rear-diff-check",
            "rear-diff",
            "transfer-case-check",
            "transfer-case",
            "driveshaft",
            "cv-axle",
            "axle-seals",
            "u-joints",
            "clutch",
            "clutch-hydraulics",
            "flywheel",
            "trans-pan-gasket",
            "shift-cable",
            "shocks",
            "springs",
            "control-arms",
            "ball-joints",
            "bushings",
            "sway-bar-links",
            "wheel-bearing",
            "tie-rods",
            "steering-rack",
            "power-steering-pump",
            "steering-parts",
            "chassis-lube",
            "suspension-check",
            "cabin-air",
            "wipers",
            "wipers-check",
            "battery",
            "battery-check",
            "key-fob-battery",
            "bulbs",
            "headlight-assembly",
            "lights-check",
            "windows-check",
            "window-regulator",
            "door-lock-actuator",
            "air-conditioning",
            "ac-flush",
            "ac-compressor",
            "ac-condenser",
            "blower-motor",
            "starter",
            "alternator",
            "fuses",
            "horn",
            "multi-point",
            "scheduled-service",
            "emissions",
            "safety-inspection",
            "recall",
            "accessory",
            "windshield",
            "mirror",
            "door-handle",
            "body",
            "detail"
          ]
        }
      }
    }
  }
}

<resources>
    <string name="app_name">Glovebox</string>
    <!-- The locale figures and dates are written in: this translation's own, so "12,345" and
         "Oct 17, 2026" read the same on every phone. A translation sets its own (de-DE). -->
    <string name="format_locale" translatable="false">en-US</string>

    <!-- Shared formatters (Mappers.kt): distances, intervals, due headlines -->
    <!-- %1$s is a number already formatted ("12,345"). -->
    <string name="distance_mi">%1$s mi</string>
    <string name="distance_km">%1$s km</string>
    <string name="unit_mi">mi</string>
    <string name="unit_km">km</string>
    <string name="unit_miles">miles</string>
    <string name="unit_kilometres">kilometres</string>
    <string name="unit_miles_title">Miles</string>
    <string name="unit_kilometres_title">Kilometres</string>
    <string name="months_short">%1$s mo</string>
    <!-- A distance and a time: "7,500 mi / 12 mo". -->
    <string name="interval_slash">%1$s / %2$s</string>
    <!-- Two ways a thing can happen: "7,500 mi or 12 mo", "73,412 mi or Apr 10, 2027". -->
    <string name="either_or">%1$s or %2$s</string>
    <string name="interval_every">Every %1$s</string>
    <string name="interval_first_then_every">First at %1$s, then every %2$s</string>
    <!-- %1$s is a service, %2$s where it is due next. -->
    <string name="reminder_change_next_due">%1$s — next due %2$s</string>
    <string name="reminder_change_not_logged">%1$s — back to not logged yet</string>
    <string name="due_not_logged">Not logged yet</string>
    <!-- %1$s is a distance or a number of days or months. -->
    <string name="due_overdue_by">Overdue %1$s</string>
    <string name="due_now">Due now</string>
    <string name="due_in">In %1$s</string>
    <string name="due_today">Due today</string>
    <string name="due_snoozed_until">Snoozed until %1$s</string>
    <plurals name="days">
        <item quantity="one">%1$s day</item>
        <item quantity="other">%1$s days</item>
    </plurals>
    <plurals name="months">
        <item quantity="one">%1$s month</item>
        <item quantity="other">%1$s months</item>
    </plurals>
    <string name="rule_whichever_first">Whichever comes first</string>
    <string name="rule_whichever_last">Whichever comes last</string>
    <string name="rule_mileage_only">Mileage only</string>
    <string name="rule_time_only">Time only</string>

    <!-- Unlock (LockScreen) -->
    <string name="unlock_prompt_title">Unlock Glovebox</string>
    <string name="unlock_locked_and_encrypted">Your data is locked and encrypted</string>
    <string name="unlock_instruction_screen_lock">Use your screen lock to open your Glovebox</string>
    <string name="unlock_instruction_fingerprint">Touch the sensor to open your Glovebox</string>
    <string name="unlock_instruction_biometric">Unlock to open your Glovebox</string>
    <string name="unlock_button_screen_lock">Unlock with screen lock</string>
    <string name="unlock_button_fingerprint">Unlock with fingerprint</string>
    <string name="unlock_button_biometric">Unlock</string>
    <!-- A phone's lock may be a pattern or a password, so it isn't called a PIN. -->
    <string name="unlock_use_screen_lock">Use screen lock instead</string>
    <string name="unlock_wait_or_use_screen_lock">Too many tries. Wait a moment, or use your screen lock.</string>
    <string name="unlock_wait">Too many tries. Wait a moment and try again.</string>
    <string name="unlock_off_until_screen_lock">Too many tries. Fingerprint and face are off until you use your screen lock.</string>
    <string name="unlock_couldnt_check">Couldn\'t check just now. Try again.</string>

    <!-- Shared -->
    <string name="cancel">Cancel</string>
    <!-- %1$s is the word to type, drawn in mono. -->
    <string name="type_word_to_confirm">Type %1$s to confirm</string>

    <!-- Welcome (WelcomeScreen) -->
    <string name="welcome_title">Welcome to Glovebox</string>
    <string name="welcome_intro">Maintenance records, reminders and recalls for your vehicles. Everything stays on this phone, encrypted.</string>
    <string name="welcome_set_up">SET UP</string>
    <string name="welcome_lock_title">Unlock with fingerprint</string>
    <string name="welcome_lock_fallback">Device PIN works as a fallback</string>
    <string name="welcome_lock_no_screen_lock">This phone has no screen lock, so the app can\'t be locked yet. Set one in Android\'s settings, then turn this on in Glovebox\'s Settings.</string>
    <string name="welcome_notifications_title">Reminder notifications</string>
    <string name="welcome_notifications_off">Off. Reminders still show inside the app</string>
    <string name="welcome_notifications_ask">Android will ask for permission next</string>
    <string name="welcome_notifications_on">When a service is due, a recall appears, or a backup is overdue</string>
    <string name="welcome_add_vehicle">Add your first vehicle</string>
    <string name="welcome_restore">Restore from a backup</string>
    <string name="welcome_privacy">Only a VIN, or a year, make and model, is ever sent out, and only to NHTSA. No account, no ads, no tracking.</string>

    <!-- Delete all data (DeleteAllScreen) -->
    <string name="delete_all_prompt_title">Delete everything in Glovebox</string>
    <string name="delete_all_prompt_subtitle">This can\'t be undone</string>
    <string name="delete_all_title">Delete everything in Glovebox?</string>
    <string name="delete_all_what_goes">All vehicles, archived vehicles, records, photos, specs, reminders and settings. The app goes back to its welcome screen.</string>
    <string name="delete_all_how_heading">How it\'s erased</string>
    <string name="delete_all_how">We delete the encryption keys from the phone\'s secure hardware, then the database and photos. Without the keys, nothing left behind can be read.</string>
    <string name="delete_all_files_elsewhere">Backup and export files you\'ve saved elsewhere aren\'t touched. Delete those yourself if you want them gone.</string>
    <string name="delete_all_cant_undo">This can\'t be undone.</string>
    <string name="delete_all_backup_first">Make a backup first</string>
    <string name="delete_all_confirm_fingerprint">Confirm with fingerprint</string>
    <string name="delete_all_confirm_screen_lock">Confirm with screen lock</string>
    <string name="delete_all_confirm">Delete everything</string>
    <string name="delete_all_no_second_check">This phone has no screen lock, so there is no second check. Pressing the button deletes everything.</string>
</resources>

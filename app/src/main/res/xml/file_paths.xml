<?xml version="1.0" encoding="utf-8"?>
<!-- The only two places a photo is ever in the clear, both in the private cache and both emptied:
     "capture" is where the camera app writes a new photo before it is encrypted, "shared" holds
     the copy handed to the share sheet. -->
<paths>
    <cache-path name="capture" path="capture/" />
    <cache-path name="shared" path="shared/" />
</paths>

<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!--
        Lint calls the -v26 on the adaptive icon's folder obsolete, since minSdk is 29, but AAPT can't find
        an adaptive icon in a plain mipmap-anydpi folder ("resource mipmap/ic_launcher not found").
    -->
    <issue id="ObsoleteSdkInt">
        <ignore path="src/main/res/mipmap-anydpi-v26" />
    </issue>
    <!--
        GradleDependency runs only in the weekly newer-versions.yml, which keeps an issue open listing what is
        newer (#639); a PR's lint skips it. Two upgrades are migrations, not version bumps, each with an issue of
        its own, so they are kept out of that list. Anything else newer (a 1.6.x CameraX, any other library) is
        listed. Remove an ignore in the PR that does its migration.
        - Compose BOM 2026.11 (Compose 1.13, Material 3 1.5), #636: needs compileSdk 37.1, moves
          ExposedDropdownMenu to an extension that must be imported, deprecates the Slider,
          rememberModalBottomSheetState and PasswordVisualTransformation the app uses, and changes a screenshot.
        - CameraX 1.7, #637: moves camera2 onto camera2-pipe, brings Guava into the APK (R8 then needs a rule for
          j2objc) and turns ImageProxy into Kotlin properties.
    -->
    <issue id="GradleDependency">
        <ignore regexp="androidx\.compose:compose-bom than 2026\.09\.00 is available" />
        <ignore regexp="androidx\.camera:camera-[a-z0-9]+ than 1\.6\.2 is available: 1\.7\." />
    </issue>
</lint>
